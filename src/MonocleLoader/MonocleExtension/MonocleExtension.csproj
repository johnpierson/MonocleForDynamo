<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The loader ships alongside Monocle and, on first run, downloads the MonocleViewExtension.dll
    matching the host's Dynamo version. It stays on net48 and an old Dynamo SDK on purpose: it has
    to load in every Dynamo from 2.x through 4.x.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamoVisualProgramming.Core" Version="2.12.1.8246" />
    <PackageReference Include="DynamoVisualProgramming.DynamoServices" Version="2.12.1.8246" />
    <PackageReference Include="DynamoVisualProgramming.WpfUILibrary" Version="2.12.1.8246" />
  </ItemGroup>

</Project>
