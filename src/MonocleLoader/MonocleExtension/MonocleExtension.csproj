<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The loader is the only DLL shipped in the Dynamo package itself. It stays net48 so the same file loads in
      every supported Dynamo (2.x on .NET Framework, 3.x+ on .NET 8/10), and it only uses long-standing Dynamo
      extension APIs (IExtension, ILogSource).
    -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyVersion>2026.10.1</AssemblyVersion>
    <FileVersion>2026.10.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only: Dynamo provides these at runtime. Never copy them into the package's bin folder. -->
    <PackageReference Include="DynamoVisualProgramming.Core" Version="[2.12.1.8246]" ExcludeAssets="runtime" />
    <PackageReference Include="DynamoVisualProgramming.DynamoServices" Version="[2.12.1.8246]" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
