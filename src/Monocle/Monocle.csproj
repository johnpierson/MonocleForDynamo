	<!-- Release builds publish into deploy\<version>\, which is what the loader extension downloads. -->
	<Target Name="CopyFiles" AfterTargets="CoreBuild" Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Release'">
		<ItemGroup>
			<AssemblyFiles Include="$(TargetDir)\MonocleViewExtension.dll" />
		</ItemGroup>
		<Message Text="Monocle $(DynamoVersion): copying from $(TargetDir) to $(FolderPackages)" Importance="high" />
		<Copy SourceFiles="@(AssemblyFiles)" DestinationFolder="$(FolderPackages)" />
	</Target>
