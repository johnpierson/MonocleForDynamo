<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  Monocle builds one assembly per supported Dynamo version, selected with -p:DynamoVersion=X.Y.
	  The supported list lives in versions.json at the repo root; scripts\build-all.ps1 drives it.
	  Dynamo 2.x is frozen: those DLLs in deploy\ are immutable artifacts and are never rebuilt.
	-->
	<PropertyGroup>
		<RootNamespace>MonocleViewExtension</RootNamespace>
		<AssemblyName>MonocleViewExtension</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyTitle>Monocle</AssemblyTitle>
		<Product>Monocle</Product>
		<Configurations>Debug;Release</Configurations>
		<!-- DynamoVersion and the per-version obj\ path are set in Directory.Build.props, which
		     MSBuild imports early enough for BaseIntermediateOutputPath to take effect. -->
	</PropertyGroup>

	<!-- Target framework follows the Dynamo runtime: 3.x is .NET 8, 4.x is .NET 10. -->
	<PropertyGroup>
		<TargetFramework Condition="$([MSBuild]::VersionLessThan('$(DynamoVersion)', '4.0'))">net8.0-windows</TargetFramework>
		<TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '4.0'))">net10.0-windows</TargetFramework>

		<!-- NuGet package version to float against. Overrides exist where Dynamo shipped no X.Y.0 package. -->
		<DynamoNuGetVersion>$(DynamoVersion)</DynamoNuGetVersion>
		<DynamoNuGetVersion Condition="'$(DynamoVersion)' == '3.3'">3.3.1</DynamoNuGetVersion>
		<DynamoPackageVersion>$(DynamoNuGetVersion).*</DynamoPackageVersion>
		<!-- 4.2 has no stable release yet; pin the beta explicitly. -->
		<DynamoPackageVersion Condition="'$(DynamoVersion)' == '4.2'">4.2.0-beta5644</DynamoPackageVersion>

		<!-- Keep final output separate per version so switching versions never reuses stale binaries. -->
		<OutputPath>bin\$(Configuration)\$(DynamoVersion)\</OutputPath>
		<FolderPackages>$(MSBuildProjectDirectory)\..\..\deploy\$(DynamoVersion)\</FolderPackages>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<!--
	  Version gates for Dynamo API changes. Everything at or below 3.0 is unconditionally true
	  now that 2.x is frozen, so only 3.1+ needs a constant.
	-->
	<PropertyGroup>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '3.1'))">$(DefineConstants);D31_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '3.2'))">$(DefineConstants);D32_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '3.3'))">$(DefineConstants);D33_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '3.4'))">$(DefineConstants);D34_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '3.5'))">$(DefineConstants);D35_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '3.6'))">$(DefineConstants);D36_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '4.0'))">$(DefineConstants);D40_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '4.1'))">$(DefineConstants);D41_OR_GREATER</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(DynamoVersion)', '4.2'))">$(DefineConstants);D42_OR_GREATER</DefineConstants>
	</PropertyGroup>

